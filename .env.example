# Render Environment Variables Template for LMS.Api
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

ConnectionStrings__DefaultConnection=Server=your-db-server;Database=LMSDB;User Id=user;Password=pass;TrustServerCertificate=true;

AzureAd__Instance=login.microsoftonline.com
AzureAd__Domain=wigweuniversity.onmicrosoft.com
AzureAd__TenantId=your-tenant-id
AzureAd__ClientId=your-client-id
AzureAd__ClientSecret=your-client-secret
AzureAd__Audience=api://your-client-id

Brevo__ApiKey=your-brevo-api-key
Brevo__SenderEmail=teamit@wigweuniversity.edu.ng
Brevo__SenderName=Wigwe University Admissions

Jwt__Issuer=LMS.Api
Jwt__Audience=LMS.Client
Jwt__SigningKey=your-production-signing-key-32-chars-min
Jwt__ExpiryMinutes=60

PushNotifications__VapidSubject=mailto:admin@wigweuniversity.edu.ng
PushNotifications__VapidPublicKey=your-vapid-public-key
PushNotifications__VapidPrivateKey=your-vapid-private-key

Cors__AllowedOrigins__0=*
ClientApp__BaseUrl=https://your-lms-frontend.onrender.com
BootstrapAdmin__Email=admin@wigweuniversity.edu.ng
NGNBulkSMS__ApiKey=your-sms-api-key
AIAgentSettings__Enabled=true
Database__ApplyMigrationsOnStartup=true
